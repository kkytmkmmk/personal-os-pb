# Copy to .env only for a local development environment. Do not commit .env.
# API keys are optional; the application is local-first by default.
PERSONAL_OS_ACCESS_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_API_KEY=
# Absolute path to mf-dashboard's local SQLite DB. Personal OS opens it read-only.
PERSONAL_OS_MONEYFORWARD_DB_PATH=
# Set false only when a large existing analysis queue is already populated.
PERSONAL_OS_QUEUE_ANALYSIS_ON_START=true
# Set false only for an already-migrated large production DB.
PERSONAL_OS_RUN_STARTUP_MAINTENANCE=true
